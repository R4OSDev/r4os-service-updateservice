R4OS_MODULE_MANIFEST=2
KIND=R4X
NAME=UPDSVC
VERSION=0.2.13
LANGUAGE=Zig
SOURCE=src/main.zig
ZIG_MODULE=system_update_engine:../../SDK/r4os/system_update_engine.zig
ZIG_MODULE=update_service_contract:../../SDK/r4os/update_service_contract.zig
ENTRY_MODE=app
APP_CLASS=service
TARGET=/R4OS/SERVICES/UPDSVC.R4X
IMAGE_SCOPE=slim
IMPORT=R4NET:Query:1
IMPORT=R4DEV:Query:1
IMPORT=R4SYS:Query:1
META=service.name=UPDSVC
META=service.args=/RUN
META=service.start=auto
META=service.enabled=yes
META=service.config=Injection\R4OS\CONFIG\SERVICES.R4S
META=feature=single-update-worker
META=feature=durable-update-state
META=feature=catalog-v2-inventory-search
META=feature=resume-sha256-atomic-download
META=feature=desktop-update-component-pages
META=feature=bounded-auth-reply-wait
META=feature=snapshot-update-all
META=feature=explicit-restart-commit
META=feature=postboot-release-confirmation
META=feature=single-live-release-confirmation
META=feature=search-release-reconciliation
META=feature=bounded-full-catalog-response
META=feature=single-restart-batch-readiness
META=feature=bounded-update-io-retry
META=feature=bounded-stage-abort-retry
META=feature=cached-offer-snapshot-rebind
META=feature=exact-status-row-binding
IMPORT=R4STD:SETTINGS_V1:1
IMPORT=R4STD:CONFIG_V1:1
ZIG_MODULE=r4std:../../Libraries/R4STD/Bindings/Zig/r4std.zig
